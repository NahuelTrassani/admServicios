<section class="cabecera">
  <h2>Servicios</h2>
  <p class="contador">
    <span id="enPantalla">{{services.length}}</span> de
    <span id="total">{{paginacion.total}}</span> servicios
    {{#if paginacion.totalPages}}· página {{paginacion.page}} de {{paginacion.totalPages}}{{/if}}
  </p>
</section>

<p class="aviso">
  Esta vista se actualiza sola: si se crea o se modifica un servicio desde la API, se ve acá sin recargar.
</p>

<p class="aviso pendiente" id="avisoNuevos" hidden></p>

<table class="tabla">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Descripción</th>
      <th>Duración</th>
      <th>Precio</th>
      <th>Categoría</th>
      <th>Disponible</th>
    </tr>
  </thead>
  <tbody
    id="listaServicios"
    data-limit="{{paginacion.limit}}"
    data-ultima-pagina="{{#if paginacion.hasNextPage}}no{{else}}si{{/if}}"
  >
    {{#each services}}
      <tr data-id="{{this._id}}">
        <td>{{this.name}}</td>
        <td>{{this.description}}</td>
        <td>{{this.duration}} min</td>
        <td>${{this.price}}</td>
        <td>{{this.category}}</td>
        <td>
          {{#if this.available}}
            <span class="estado si">disponible</span>
          {{else}}
            <span class="estado no">no disponible</span>
          {{/if}}
        </td>
      </tr>
    {{else}}
      <tr class="vacio">
        <td colspan="6">Todavía no hay servicios cargados.</td>
      </tr>
    {{/each}}
  </tbody>
</table>

{{#if paginacion.totalPages}}
  <nav class="paginacion">
    {{#if paginacion.hasPrevPage}}
      <a href="/views/services?page={{paginacion.prevPage}}">Anterior</a>
    {{/if}}
    {{#if paginacion.hasNextPage}}
      <a href="/views/services?page={{paginacion.nextPage}}">Siguiente</a>
    {{/if}}
  </nav>
{{/if}}
